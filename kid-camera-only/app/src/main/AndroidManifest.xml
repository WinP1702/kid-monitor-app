<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Boot & persistence -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Microphone — for remote mic monitoring feature -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Manufacturer-specific autostart permissions -->
    <uses-permission android:name="com.miui.securitycenter.permission.AUTOSTART" />
    <uses-permission android:name="com.coloros.safecenter.permission.AUTOSTART" />
    <uses-permission android:name="oppo.permission.OPPO_COMPONENT_SAFE" />
    <uses-permission android:name="com.vivo.permission.START_BACKGROUND_APP" />
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:theme="@style/Theme.KidCamera"
        android:directBootAware="true"
        tools:targetApi="31">

        <!-- ══════════════════════════════════════════════ -->
        <!--  SETUP ACTIVITY  (only shown once at install) -->
        <!-- ══════════════════════════════════════════════ -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ══════════════════════════════════════════════ -->
        <!--  CAMERA STREAM SERVICE                        -->
        <!-- ══════════════════════════════════════════════ -->
        <service
            android:name=".CameraStreamService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone"
            android:stopWithTask="false"
            android:directBootAware="true" />

        <!-- ══════════════════════════════════════════════ -->
        <!--  RECEIVERS                                    -->
        <!-- ══════════════════════════════════════════════ -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="miui.intent.action.BOOT_COMPLETED" />
                <action android:name="android.huawei.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Watchdog: AlarmManager fires this every 4 min to restart dead services -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

    </application>
</manifest>
