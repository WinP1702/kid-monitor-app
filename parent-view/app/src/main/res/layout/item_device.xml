<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#121228"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: icon + name + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="📱"
                android:textSize="24sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kid's Phone"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvLastSeen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Online now"
                    android:textSize="12sp"
                    android:textColor="#AAAACC"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textSize="10sp"
                android:textColor="#4FC3F7"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Screenshot count / status info -->
        <TextView
            android:id="@+id/tvScreenshotCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoring active"
            android:textSize="12sp"
            android:textColor="#66778899"
            android:layout_marginTop="8dp"
            android:layout_marginStart="48dp" />

        <!-- Live Screen + App Usage + Camera buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnLiveScreen"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="📺 Screen"
                android:backgroundTint="#1A4FC3F7"
                android:textColor="#4FC3F7"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnLiveCamera"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="📷 Camera"
                android:backgroundTint="#1AFFD54F"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:layout_marginHorizontal="2dp" />

            <Button
                android:id="@+id/btnAppUsage"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="📊 Usage"
                android:backgroundTint="#1A66BB88"
                android:textColor="#66BB88"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Delete device button -->
        <Button
            android:id="@+id/btnDeleteDevice"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🗑 Remove Device"
            android:backgroundTint="#00000000"
            android:textColor="#FF5555"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <!-- Hidden: kept for adapter compatibility -->
        <Button
            android:id="@+id/btnView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
